NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/community-store
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*
CACHE_ENABLED=true
CACHE_DRIVER=memory
CACHE_URL=
CACHE_MAX_ENTRIES=500
CACHE_DEFAULT_TTL_SECONDS=60
APP_BASE_URL=http://192.168.1.100:5000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
UPLOAD_DIR=src/uploads
MAX_FILE_SIZE_MB=5
